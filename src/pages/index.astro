---
// Astro Component Script (Runs on server during build)
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>HolyC to Wasm Browser Compiler</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      display: flex;
      height: 100vh;
      font-family: monospace;
      background-color: #1e1e1e;
      color: #d4d4d4;
    }
    #editor-container {
      flex: 1;
      border-right: 2px solid #333;
    }
    #right-panel {
      flex: 1;
      display: flex;
      flex-direction: column;
      padding: 10px;
    }
    #controls {
      display: flex;
      gap: 10px;
      margin-bottom: 10px;
    }
    button {
      padding: 8px 16px;
      background: #007acc;
      color: white;
      border: none;
      cursor: pointer;
      font-weight: bold;
    }
    button:hover { background: #005f9e; }
    #output {
      flex: 1;
      background: black;
      color: #0f0;
      padding: 10px;
      overflow-y: auto;
      white-space: pre-wrap;
      margin-bottom: 10px;
    }
    #canvas {
      width: 100%;
      height: 300px;
      background: white;
      border: 1px solid #333;
    }
  </style>
</head>
<body>
  <div id="editor-container"></div>
  <div id="right-panel">
    <div id="controls">
      <button id="run-btn">Compile & Run</button>
      <button id="clear-btn">Clear Output</button>
    </div>
    <div id="output">Welcome to the HolyC Browser Compiler!
Press "Compile & Run" to execute code.
</div>
    <canvas id="canvas" width="600" height="300"></canvas>
  </div>
  
  <script src="../main.ts"></script>
</body>
</html>
